# Obsidian workspace/cache (개인 UI 상태 — 지식이 아님)
.obsidian/

# The `wiki` knowledge base is a SEPARATE repo, never part of this one. The
# templates the pipeline actually consumes were vendored into `templates/` on
# 2026-07-13 to break the live dependency (each carries a `provenance` note).
# A local `wiki/` clone must never be re-added -- `git add` on a nested repo
# silently records a URL-less gitlink (mode 160000) that breaks fresh clones.
wiki/

# OS
.DS_Store

# Python
__pycache__/
*.pyc

# Claude Code local settings
.claude/settings.local.json

# Pipeline execution data (copy of source-cases/ + intermediate outputs -- originals version-controlled in source-cases/)
data/
*.pdf
*.zip
*.txt
*.pptx
CASE_112_pipeline_walkthrough/
docs/
.tmp/
plans/

# Workspace Data with each run's report written by agent
_workspace/

# Pipeline contract outputs -- per-run generated artifacts, not source of truth
outputs/

# archived legacy files
archive/

# Transient file locks (P5) -- must never be committed
*.lock

# Shared temp zip (schemas/ is the source of truth)
schemas.zip

# Local scratch workspace (extracted page PDFs/images etc.) -- transient working
# files, never a source of truth. Raw sources live in source-cases/.
tmp/

# ocr_extract.py's project-local scratch (page images) -- transient, cleaned up on exit
_ocr_scratch/
_stage2_scratch/
_stage2_reset_backups/

# Checkpoint 2's short-lived page-text capabilities. Minted per document and
# revoked when the run ends; never source, never worth committing.
_capabilities/
_redaction_scratch/
_segmentation_scratch/
_source-cases/
source-cases/

# segment_case.py's contact sheets and per-sheet resume cache. Kept separate from
# _ocr_scratch/ because these deliberately OUTLIVE the process: a human reads the
# sheets to approve boundaries, so nothing here may be rmtree'd on exit.
_segmentation_scratch/

# Project-local offline runtimes and model weights (downloaded, never versioned)
.runtime/

# Protected loss-adjustment format-study artifacts. These contain source-derived
# material or source-path-bearing review metadata and must stay out of commits.
loss-adjustment-format-study/_ocr_cache/
loss-adjustment-format-study/_working/
loss-adjustment-format-study/manifest.json
/sources/
loss-adjustment-format-study/boundary-review.json
loss-adjustment-format-study/independent-boundary-review.json
loss-adjustment-format-study/sections/
loss-adjustment-format-study/no-report/
loss-adjustment-format-study/analysis/report-index.csv

# graphify knowledge-graph build output -- regenerable from the corpus, not source
graphify-out/

# Pipeline viewer frontend -- build artifacts and venvs, not source
frontend/web/node_modules/
frontend/web/dist/
frontend/web/dist-static/
frontend/backend/venv/
frontend/backend/_uploads/
frontend/backend/_runs.json
frontend/backend/_run_logs/
*.stackdump
