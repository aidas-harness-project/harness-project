{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "claim_analysis_trace.schema.json",
  "title": "Internal selective-reading trace for Claim Analysis v0.1",
  "description": "Development and performance trace kept separate from the downstream authority contract. It records what was considered, read, skipped, and stopped without repeating extracted claim facts.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "case_id": { "$ref": "common_component_output.schema.json#/$defs/case_id" },
    "run_id": { "type": "string", "pattern": "^RUN_[0-9]{8}_[0-9]+$" },
    "schema_version": { "const": "claim_analysis_trace.v0.1" },
    "config_version": { "const": "claim_analysis_routing.v0.1" },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "document_id": { "$ref": "common_component_output.schema.json#/$defs/document_id" },
          "medical_document_kind": { "$ref": "medical_document_classification.schema.json#/$defs/medical_document_kind" },
          "disposition": { "enum": ["read", "skipped", "presence_only", "ambiguous"] },
          "wave": { "enum": ["A", "B", "not_read"] },
          "reason": { "type": "string", "minLength": 1 },
          "field_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" } }
        },
        "required": ["document_id", "disposition", "wave", "reason", "field_ids"]
      }
    },
    "field_stops": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "field_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "stop_reason": { "enum": ["trusted_value_found", "sources_exhausted", "conflict_found", "not_applicable"] },
          "documents_read": { "type": "integer", "minimum": 0 },
          "additional_comparisons": { "type": "integer", "minimum": 0, "maximum": 1 }
        },
        "required": ["field_id", "stop_reason", "documents_read", "additional_comparisons"]
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "documents_considered": { "type": "integer", "minimum": 0 },
        "documents_read": { "type": "integer", "minimum": 0 },
        "documents_presence_only": { "type": "integer", "minimum": 0 },
        "a_stop_fields": { "type": "integer", "minimum": 0 },
        "b_fallback_fields": { "type": "integer", "minimum": 0 },
        "provider_calls": { "type": "integer", "minimum": 0 },
        "input_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "output_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "wall_time_seconds": { "type": ["number", "null"], "minimum": 0 }
      },
      "required": ["documents_considered", "documents_read", "documents_presence_only", "a_stop_fields", "b_fallback_fields", "provider_calls", "input_tokens", "output_tokens", "wall_time_seconds"]
    }
  },
  "required": ["case_id", "run_id", "schema_version", "config_version", "documents", "field_stops", "metrics"]
}
