{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "claim_analysis_routing_config.schema.json",
  "title": "Claim Analysis selective-reading and routing configuration v0.1",
  "description": "Versioned design contract for the traumatic-injury PoC. It separates medical-advisory priority from PoC extraction activation, routes each field to ordered document kinds, and keeps cost documents presence-only. behavior_enabled remains false until the governed runtime integration is approved.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "claim_analysis_routing_config.v0.1"
    },
    "config_version": {
      "const": "claim_analysis_routing.v0.1"
    },
    "behavior_enabled": {
      "type": "boolean"
    },
    "activation": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "approved_by": {
              "type": "string",
              "minLength": 1
            },
            "authority_role": {
              "type": "string",
              "minLength": 1
            },
            "approved_at": {
              "type": "string",
              "format": "date-time"
            },
            "scope": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "approved_by",
            "authority_role",
            "approved_at",
            "scope"
          ]
        }
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "case_scope": {
          "const": "traumatic_injury_poc"
        },
        "automatic_grade_ceiling": {
          "const": "B"
        },
        "disease_handling": {
          "const": "basic_diagnosis_only"
        },
        "cancer_module": {
          "const": "deferred"
        },
        "amount_calculation": {
          "const": "out_of_scope"
        },
        "final_eligibility": {
          "const": "out_of_scope"
        }
      },
      "required": [
        "case_scope",
        "automatic_grade_ceiling",
        "disease_handling",
        "cancer_module",
        "amount_calculation",
        "final_eligibility"
      ]
    },
    "extraction_policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "waves": {
          "const": [
            "A",
            "B"
          ]
        },
        "read_document_once_per_run": {
          "const": true,
          "description": "A document is handed to the provider at most once across the WHOLE Claim Analysis run, not once per wave. The A and B plans are computed together, one read extracts every field that document is responsible for, and the structured result is cached; wave B and the critical-field comparison read the cache rather than paying for the document again. Waves therefore order the stop rule's priority, not the number of reads."
        },
        "parallel_within_wave": {
          "const": true
        },
        "stop_on_first_trusted_value": {
          "const": true
        },
        "trusted_value_requirements": {
          "type": "array",
          "const": [
            "priority_source",
            "exact_quote",
            "complete",
            "unambiguous"
          ]
        },
        "critical_field_additional_comparison_limit": {
          "const": 1
        },
        "missing_mention_is_conflict": {
          "const": false
        },
        "direct_conflict_canonical_value": {
          "const": null
        }
      },
      "required": [
        "waves",
        "read_document_once_per_run",
        "parallel_within_wave",
        "stop_on_first_trusted_value",
        "trusted_value_requirements",
        "critical_field_additional_comparison_limit",
        "missing_mention_is_conflict",
        "direct_conflict_canonical_value"
      ]
    },
    "document_kinds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "$ref": "medical_document_classification.schema.json#/$defs/medical_document_kind"
          },
          "default_roles": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "medical_document_classification.schema.json#/$defs/medical_role"
            }
          },
          "claim_analysis_read_mode": {
            "enum": [
              "content",
              "presence_only"
            ]
          }
        },
        "required": [
          "kind",
          "default_roles",
          "claim_analysis_read_mode"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "enum": [
                    "medical_expense_receipt",
                    "medical_expense_itemization",
                    "pharmacy_payment_confirmation"
                  ]
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "properties": {
                "default_roles": {
                  "const": [
                    "required_document_presence_only"
                  ]
                },
                "claim_analysis_read_mode": {
                  "const": "presence_only"
                }
              }
            }
          }
        ]
      }
    },
    "domains": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "effective_first_required_grade": {
            "enum": [
              "A",
              "B"
            ],
            "description": "The medical advisory grade at which a field in this domain first becomes required. Meaningful only for a `medical` domain; a `legal_factual` domain may omit it, since its fields carry no medical grade to compare against."
          },
          "label_ko": {
            "type": "string",
            "minLength": 1,
            "description": "owner: routing config. The reader-facing Korean name, printed by the screening report. `label` remains the English identifier used in code and documentation; this is what a 손해사정사 reads."
          },
          "domain_kind": {
            "enum": [
              "medical",
              "legal_factual"
            ],
            "description": "What KIND of fact the domain holds. `medical` is the default and covers all eight original domains -- their fields are clinical findings a 의사 grades. `legal_factual` holds facts about liability, fault and contract terms: a 손해사정사 or a 법률전문가 reads them, and grading them on medical advisory priority is meaningless. Absent, a domain is `medical`."
          }
        },
        "required": [
          "code",
          "label",
          "label_ko"
        ],
        "allOf": [
          {
            "$comment": "A medical domain still declares its grade ceiling; the eight original domains are unaffected.",
            "if": {
              "anyOf": [
                {
                  "properties": {
                    "domain_kind": {
                      "const": "medical"
                    }
                  },
                  "required": [
                    "domain_kind"
                  ]
                },
                {
                  "not": {
                    "required": [
                      "domain_kind"
                    ]
                  }
                }
              ]
            },
            "then": {
              "required": [
                "effective_first_required_grade"
              ]
            }
          }
        ]
      },
      "description": "Nine domains: the eight medical ones (fixed -- they are the agreed clinical fact taxonomy and the count is pinned so one cannot be added or dropped quietly) plus `liability_basis`, added 2026-08-21 for facts that are not clinical at all. The medical count is enforced separately below, so raising this bound alone cannot smuggle in a ninth medical domain."
    },
    "fields": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "field_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "domain_code": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "medical_advisory_grade": {
            "enum": [
              "A",
              "B",
              "C",
              "D"
            ],
            "description": "Clinical advisory priority. Required for a field in a `medical` domain; a `legal_factual` field omits it and declares `priority_grade` instead."
          },
          "extraction_wave": {
            "enum": [
              "A",
              "B",
              "opportunistic",
              "deferred"
            ]
          },
          "activation_basis": {
            "enum": [
              "advisory_priority",
              "routing_override",
              "consistency_override",
              "intake_only",
              "deferred"
            ]
          },
          "value_shape": {
            "enum": [
              "boolean",
              "code",
              "date",
              "enum",
              "number",
              "period",
              "text",
              "text_list"
            ]
          },
          "cardinality": {
            "enum": [
              "single",
              "multi"
            ]
          },
          "source_route_id": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "critical_conflict_field": {
            "type": "boolean"
          },
          "notes": {
            "type": "string",
            "minLength": 1
          },
          "label_ko": {
            "type": "string",
            "minLength": 1,
            "description": "owner: routing config. The reader-facing Korean name, printed by the screening report. `label` remains the English identifier used in code and documentation; this is what a 손해사정사 reads."
          },
          "priority_grade": {
            "enum": [
              "A",
              "B",
              "C"
            ],
            "description": "The field's own extraction priority, for a field with no medical grade. A `legal_factual` field declares this instead of `medical_advisory_grade`: 과실비율 is not a clinical finding a 의사 ranks, and forcing a medical grade onto it produced the wrong signal -- `facility_defect_or_third_party_responsibility` sits at grade C (medically unimportant) while being the single field liability is judged on. A medical field leaves this unset and its priority is derived from `medical_advisory_grade` as before."
          },
          "legal_authority": {
            "enum": [
              "asserted_fact",
              "legal_opinion"
            ],
            "description": "For a `legal_factual` field, whether the value is a FACT stated in a document (a policy's 자기부담금, a 사고일) or an OPINION a party's counsel reached (배상책임 성립 여부, 과실비율). Two opposing opinions are not a contradiction to be resolved -- they are the dispute the case is about -- so this axis is what stops `consistency_check` filing them as a records conflict."
          }
        },
        "required": [
          "field_id",
          "domain_code",
          "label",
          "extraction_wave",
          "activation_basis",
          "value_shape",
          "cardinality",
          "source_route_id",
          "critical_conflict_field",
          "label_ko"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "medical_advisory_grade": {
                  "const": "D"
                }
              },
              "required": [
                "medical_advisory_grade"
              ]
            },
            "then": {
              "properties": {
                "extraction_wave": {
                  "const": "deferred"
                },
                "activation_basis": {
                  "const": "deferred"
                },
                "source_route_id": {
                  "type": "null"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "medical_advisory_grade": {
                  "const": "C"
                },
                "extraction_wave": {
                  "enum": [
                    "A",
                    "B"
                  ]
                }
              },
              "required": [
                "medical_advisory_grade",
                "extraction_wave"
              ]
            },
            "then": {
              "properties": {
                "extraction_wave": {
                  "const": "B"
                },
                "activation_basis": {
                  "enum": [
                    "routing_override",
                    "consistency_override"
                  ]
                }
              }
            }
          },
          {
            "$comment": "Exactly one grading axis. A field carries a medical grade or a priority grade, never both and never neither -- 'neither' would make its wave unorderable, and 'both' would leave two rankings to disagree.",
            "oneOf": [
              {
                "required": [
                  "medical_advisory_grade"
                ],
                "not": {
                  "required": [
                    "priority_grade"
                  ]
                }
              },
              {
                "required": [
                  "priority_grade"
                ],
                "not": {
                  "required": [
                    "medical_advisory_grade"
                  ]
                }
              }
            ]
          }
        ]
      }
    },
    "source_routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "route_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "source_kind": {
            "enum": [
              "medical_document",
              "administrative_or_intake"
            ],
            "description": "What kind of source this route reads. 'medical_document' routes rank medical form kinds in priority_groups. 'administrative_or_intake' routes read filing records or the intake declaration instead -- material that is NOT a medical form, and deliberately is not registered in medical_document_kind: adding an administrative form to that enum would contaminate Stage 2's classification contract, which types medical records."
          },
          "activation_condition": {
            "enum": [
              "always",
              "industrial_accident_filed_or_applicable"
            ],
            "description": "When the route is live. 'always' is every ordinary route. A conditional route opens NO document until its condition holds -- 'industrial_accident_filed_or_applicable' requires that industrial-accident filing is confirmed, or that the industrial_accident case type came back applicable. Absent that trigger the route contributes nothing and costs no read."
          },
          "priority_groups": {
            "type": "array",
            "minItems": 0,
            "items": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "medical_document_classification.schema.json#/$defs/medical_document_kind"
              }
            }
          },
          "non_medical_sources": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "industrial_accident_filing_record",
                "intake_declaration"
              ]
            },
            "description": "Ordered non-medical sources for an administrative_or_intake route."
          },
          "allow_intake_source": {
            "type": "boolean"
          },
          "read_only_if_already_open": {
            "type": "boolean",
            "description": "false means the route may open a source that is not already in the cache. An administrative route sets this false: once its trigger fires it is allowed to read the filing record it needs. That permission is scoped to its own non_medical_sources -- it never opens an additional MEDICAL document -- and the read still counts against the one-provider-call-per-document budget."
          }
        },
        "required": [
          "route_id",
          "source_kind",
          "activation_condition",
          "priority_groups",
          "allow_intake_source",
          "read_only_if_already_open"
        ],
        "allOf": [
          {
            "$comment": "A medical route ranks medical kinds and names no non-medical source.",
            "if": {
              "properties": {
                "source_kind": {
                  "const": "medical_document"
                }
              },
              "required": [
                "source_kind"
              ]
            },
            "then": {
              "properties": {
                "priority_groups": {
                  "minItems": 1
                }
              },
              "not": {
                "required": [
                  "non_medical_sources"
                ]
              }
            }
          },
          {
            "$comment": "An administrative route carries no medical priority ladder at all -- that is what keeps it from opening a medical document.",
            "if": {
              "properties": {
                "source_kind": {
                  "const": "administrative_or_intake"
                }
              },
              "required": [
                "source_kind"
              ]
            },
            "then": {
              "properties": {
                "priority_groups": {
                  "maxItems": 0
                }
              },
              "required": [
                "non_medical_sources"
              ]
            }
          }
        ]
      }
    },
    "case_type_rules": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "case_type": {
            "enum": [
              "personal_insurance",
              "traffic_accident",
              "industrial_accident",
              "liability"
            ]
          },
          "positive_fact": {
            "type": "string",
            "minLength": 1
          },
          "uncertain_fact": {
            "type": [
              "string",
              "null"
            ]
          },
          "evaluation_mode": {
            "const": "independent_parallel"
          },
          "absence_means_false": {
            "const": false
          },
          "evidence_required": {
            "const": true
          }
        },
        "required": [
          "case_type",
          "positive_fact",
          "uncertain_fact",
          "evaluation_mode",
          "absence_means_false",
          "evidence_required"
        ]
      }
    },
    "required_documents_by_case_type": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "personal_insurance": {
          "$ref": "#/$defs/document_kind_list"
        },
        "traffic_accident": {
          "$ref": "#/$defs/document_kind_list"
        },
        "industrial_accident": {
          "$ref": "#/$defs/document_kind_list"
        },
        "liability": {
          "$ref": "#/$defs/document_kind_list"
        }
      },
      "required": [
        "personal_insurance",
        "traffic_accident",
        "industrial_accident",
        "liability"
      ]
    },
    "additional_fields_by_case_type": {
      "type": "object",
      "additionalProperties": false,
      "description": "Stage 3-a: the second extraction round, run AFTER case-type assessment. It re-opens fields the common pass left `unavailable`, from sources the medical routes never reach. It does NOT introduce new fields -- every field_id must already exist in `fields` -- because the 56-field catalogue is deliberately case-type-agnostic; what a case type changes is which SOURCE may answer, not which facts matter. Measured on CASE_053: `facility_defect_or_third_party_responsibility` sat `unavailable/sources_exhausted` while two 법률의견서 in the same case argued the question directly, because `accident_context` ranks only medical form kinds.",
      "properties": {
        "personal_insurance": {
          "$ref": "#/$defs/additional_field_round"
        },
        "traffic_accident": {
          "$ref": "#/$defs/additional_field_round"
        },
        "industrial_accident": {
          "$ref": "#/$defs/additional_field_round"
        },
        "liability": {
          "$ref": "#/$defs/additional_field_round"
        }
      },
      "required": [
        "personal_insurance",
        "traffic_accident",
        "industrial_accident",
        "liability"
      ]
    },
    "filing_status_policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "intake_value_authoritative": {
          "const": true
        },
        "default_when_missing": {
          "const": "unknown"
        },
        "search_when_missing": {
          "const": "opportunistic_in_already_read_documents"
        },
        "extra_read_for_status": {
          "const": false
        }
      },
      "required": [
        "intake_value_authoritative",
        "default_when_missing",
        "search_when_missing",
        "extra_read_for_status"
      ]
    },
    "policy_linking": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "performed_in_claim_analysis": {
          "const": true
        },
        "clause_link_statuses": {
          "const": [
            "matched",
            "candidate",
            "not_found"
          ]
        },
        "requirement_evidence_statuses": {
          "const": [
            "supported",
            "contradicted",
            "unknown",
            "conflict"
          ]
        },
        "final_applicability_decision": {
          "const": false
        },
        "amount_calculation": {
          "const": false
        },
        "coverage_terms_note": {
          "type": "string"
        },
        "coverage_term_fields": {
          "type": "array",
          "description": "Search terms justified by a claim fact: the term is searched only when that field resolved asserted or conflict. Optional -- absent means the built-in personal-insurance list in tools/claim_analysis_policy_links.py.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "field_id": {
                "type": "string"
              },
              "term": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "field_id",
              "term"
            ]
          }
        },
        "coverage_terms_by_case_type": {
          "type": "object",
          "description": "Search terms justified by the case TYPE rather than by a medical fact. A liability policy prints none of the medical coverage names, so the type is the only signal that reaches its clauses. A term must name a coverage -- in a Korean policy, the owning 약관's name -- never an article heading like 보상하는 손해, which every 약관 in a bundle repeats.",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "coverage_id": {
                  "type": "string"
                },
                "term": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "coverage_id",
                "term"
              ]
            }
          }
        }
      },
      "required": [
        "performed_in_claim_analysis",
        "clause_link_statuses",
        "requirement_evidence_statuses",
        "final_applicability_decision",
        "amount_calculation"
      ]
    }
  },
  "required": [
    "schema_version",
    "config_version",
    "behavior_enabled",
    "activation",
    "scope",
    "extraction_policy",
    "document_kinds",
    "domains",
    "fields",
    "source_routes",
    "case_type_rules",
    "required_documents_by_case_type",
    "additional_fields_by_case_type",
    "filing_status_policy",
    "policy_linking"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "behavior_enabled": {
            "const": true
          }
        },
        "required": [
          "behavior_enabled"
        ]
      },
      "then": {
        "properties": {
          "activation": {
            "type": "object"
          }
        }
      }
    },
    {
      "$comment": "Exactly eight medical domains. The bound above counts all domains; this one keeps the clinical taxonomy fixed while a non-medical domain may be added.",
      "properties": {
        "domains": {
          "contains": {
            "properties": {
              "domain_kind": {
                "const": "legal_factual"
              }
            },
            "required": [
              "domain_kind"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        }
      }
    }
  ],
  "$defs": {
    "document_kind_list": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "medical_document_classification.schema.json#/$defs/medical_document_kind"
      }
    },
    "additional_field_round": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "trigger": {
          "enum": [
            "in_play"
          ],
          "description": "When the round opens. `in_play` means any verdict except `not_applicable` -- an `uncertain` type counts. Requiring `applicable` would be circular on exactly the cases this exists for: the type is uncertain BECAUSE its deciding field is unavailable, so gating the re-read on a decided verdict guarantees it never runs. Only an affirmative negative from a source closes the round."
        },
        "field_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "description": "Fields this case type may re-open. Each MUST name a row in `fields`; a validator enforces that, because a typo would otherwise silently extract nothing. An empty array is a real answer -- it says the common pass already covers this type -- not a placeholder."
        },
        "sources": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "legal_opinion",
              "legal_reference",
              "insurer_response"
            ]
          },
          "description": "Coarse `document_type` codes to read, in priority order. Deliberately NOT medical kinds: a medical route already ranks those, and the whole point of this round is reaching documents no medical ladder names. `legal_opinion` leads `insurer_response` where both apply -- the opinion argues the question, the insurer's letter only summarizes one."
        }
      },
      "required": [
        "trigger",
        "field_ids",
        "sources"
      ],
      "allOf": [
        {
          "$comment": "Fields without sources could never be answered; sources without fields would read a document for nothing. Either alone is a config mistake, so both must be empty or both non-empty.",
          "if": {
            "properties": {
              "field_ids": {
                "minItems": 1
              }
            },
            "required": [
              "field_ids"
            ]
          },
          "then": {
            "properties": {
              "sources": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "sources": {
                "minItems": 1
              }
            },
            "required": [
              "sources"
            ]
          },
          "then": {
            "properties": {
              "field_ids": {
                "minItems": 1
              }
            }
          }
        }
      ]
    }
  }
}
