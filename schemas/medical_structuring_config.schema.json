{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "medical_structuring_config.schema.json",
  "title": "Medical structuring configuration v0.1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "medical_structuring_config.v0.1" },
    "config_version": { "type": "string", "pattern": "^medical_structuring\\.v[0-9]+\\.[0-9]+$" },
    "behavior_enabled": { "type": "boolean" },
    "approval": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "approved_by": { "type": "string", "minLength": 1 },
            "authority_role": { "type": "string", "minLength": 1 },
            "decision_record": { "type": "string", "minLength": 1 },
            "approved_at": { "type": "string", "format": "date-time" },
            "scope": { "type": "string", "minLength": 1 }
          },
          "required": ["approved_by", "authority_role", "decision_record", "approved_at", "scope"]
        }
      ]
    },
    "enabled_case_types": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "enabled_document_roles": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "domains": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "label": { "type": "string", "minLength": 1 }
        },
        "required": ["code", "label"]
      }
    },
    "variable_kinds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "domain_code": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "label": { "type": "string", "minLength": 1 }
        },
        "required": ["code", "domain_code", "label"]
      }
    },
    "importance_tiers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "tier": { "enum": ["A", "B", "C"] },
          "description": { "type": "string", "minLength": 1 }
        },
        "required": ["tier", "description"]
      }
    },
    "units": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "quantity_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "rule_id": { "type": "string", "minLength": 1 },
          "variable_kind": { "type": "string", "minLength": 1 },
          "counting_basis": { "type": "string", "minLength": 1 },
          "allowed_units": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
        },
        "required": ["rule_id", "variable_kind", "counting_basis", "allowed_units"]
      }
    }
  },
  "required": ["schema_version", "config_version", "behavior_enabled", "approval", "enabled_case_types", "enabled_document_roles", "domains", "variable_kinds", "importance_tiers", "units", "quantity_rules"],
  "allOf": [
    {
      "if": { "properties": { "behavior_enabled": { "const": true } }, "required": ["behavior_enabled"] },
      "then": {
        "properties": {
          "approval": { "type": "object" },
          "enabled_case_types": { "minItems": 1 },
          "enabled_document_roles": { "minItems": 1 },
          "variable_kinds": { "minItems": 1 }
        }
      }
    }
  ]
}