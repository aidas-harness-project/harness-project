{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "medical_review_request_config.schema.json",
  "title": "Requested-interpretation vocabulary v0.1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "medical_review_request_config.v0.1" },
    "config_version": { "type": "string", "pattern": "^medical_review_request\\.v[0-9]+\\.[0-9]+$" },
    "requests_enabled": { "type": "boolean" },
    "approval": { "oneOf": [{ "type": "null" }, { "$ref": "medical_review_common.schema.json#/$defs/approval" }] },
    "interpretations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "label": { "type": "string", "minLength": 1 },
          "allowed_issue_categories": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "medical_common.schema.json#/$defs/issue_category" } },
          "allowed_specialty_codes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "medical_review_common.schema.json#/$defs/specialty_code" } }
        },
        "required": ["code", "label", "allowed_issue_categories", "allowed_specialty_codes"]
      }
    }
  },
  "required": ["schema_version", "config_version", "requests_enabled", "approval", "interpretations"],
  "allOf": [{
    "if": { "properties": { "requests_enabled": { "const": true } }, "required": ["requests_enabled"] },
    "then": { "properties": { "approval": { "$ref": "medical_review_common.schema.json#/$defs/approval" }, "interpretations": { "minItems": 1 } } }
  }]
}