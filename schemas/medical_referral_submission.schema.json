{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "medical_referral_submission.schema.json",
  "title": "Caller referral decision submission v0.1",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "anomaly": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "anomaly_id": { "type": "string", "pattern": "^MA_[0-9]{4}$" },
        "anomaly_kind": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "severity_state": { "enum": ["classified", "unclassified_pending_policy"] },
        "severity_code": { "type": "string" },
        "variable_ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "medical_common.schema.json#/$defs/variable_id" } },
        "observation_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "medical_common.schema.json#/$defs/observation_id" } },
        "evidence_locator_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "medical_common.schema.json#/$defs/evidence_locator_id" } },
        "rationale": { "type": "string", "minLength": 1 }
      },
      "required": ["anomaly_id", "anomaly_kind", "severity_state", "variable_ids", "observation_ids", "evidence_locator_ids", "rationale"]
    },
    "request_submission": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "issue_id": { "$ref": "medical_common.schema.json#/$defs/issue_id" },
        "issue_category": { "$ref": "medical_common.schema.json#/$defs/issue_category" },
        "question": { "type": "string", "minLength": 1 },
        "question_scope": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "scope_kind": { "const": "issue_only" },
            "requested_interpretation": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
            "subject_variable_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "medical_common.schema.json#/$defs/variable_id" } },
            "subject_observation_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "medical_common.schema.json#/$defs/observation_id" } },
            "time_window": { "oneOf": [{ "type": "null" }, { "$ref": "medical_common.schema.json#/$defs/temporal_value" }] }
          },
          "required": ["scope_kind", "requested_interpretation", "subject_variable_ids", "subject_observation_ids", "time_window"]
        },
        "suggested_specialty_code": { "$ref": "medical_review_common.schema.json#/$defs/specialty_code" },
        "case_summary": { "type": "string", "minLength": 1 },
        "accident_summary": { "type": "string", "minLength": 1 },
        "timeline_observation_ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "medical_common.schema.json#/$defs/observation_id" } },
        "prior_condition_observation_ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "medical_common.schema.json#/$defs/observation_id" } },
        "prognostic_observation_ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "medical_common.schema.json#/$defs/observation_id" } },
        "included_issue_evidence_link_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "medical_common.schema.json#/$defs/issue_evidence_link_id" } },
        "included_evidence_locator_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "medical_common.schema.json#/$defs/evidence_locator_id" } },
        "omitted_supporting_links": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": { "issue_evidence_link_id": { "$ref": "medical_common.schema.json#/$defs/issue_evidence_link_id" }, "reason": { "type": "string", "minLength": 1 } },
            "required": ["issue_evidence_link_id", "reason"]
          }
        },
        "uncertainties": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "source_coverage": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "schema_version": { "const": "medical_review_request.v0.1" },
        "referral_policy_version": { "type": ["string", "null"] }
      },
      "required": ["issue_id", "issue_category", "question", "question_scope", "suggested_specialty_code", "case_summary", "accident_summary", "timeline_observation_ids", "prior_condition_observation_ids", "prognostic_observation_ids", "included_issue_evidence_link_ids", "included_evidence_locator_ids", "omitted_supporting_links", "uncertainties", "source_coverage", "schema_version", "referral_policy_version"]
    }
  },
  "properties": {
    "referral_inputs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "issue_id": { "$ref": "medical_common.schema.json#/$defs/issue_id" },
        "anomalies": { "type": "array", "items": { "$ref": "#/$defs/anomaly" } },
        "convergence": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": { "enum": ["none", "single_signal", "multiple_signals"] },
            "contributing_anomaly_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^MA_[0-9]{4}$" } },
            "common_issue_id": { "$ref": "medical_common.schema.json#/$defs/issue_id" },
            "rationale": { "type": "string", "minLength": 1 }
          },
          "required": ["status", "contributing_anomaly_ids", "common_issue_id", "rationale"]
        },
        "importance_assignment_ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "medical_common.schema.json#/$defs/importance_assignment_id" } },
        "source_coverage_statuses": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["consumed", "blocked_upstream", "unsupported_needs_configuration", "human_only_not_consumed"] } },
        "schema_version": { "const": "medical_referral_inputs.v0.1" },
        "config_version": { "$ref": "medical_common.schema.json#/$defs/config_version" }
      },
      "required": ["issue_id", "anomalies", "convergence", "importance_assignment_ids", "source_coverage_statuses", "schema_version", "config_version"]
    },
    "source_reinspection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "performed": { "type": "boolean" },
        "observation_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "medical_common.schema.json#/$defs/observation_id" } },
        "evidence_locator_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "medical_common.schema.json#/$defs/evidence_locator_id" } },
        "result": { "enum": ["resolved", "unresolved", "insufficient_source", "blocked_upstream"] },
        "unresolved_reason": { "type": ["string", "null"], "minLength": 1 }
      },
      "required": ["performed", "observation_ids", "evidence_locator_ids", "result", "unresolved_reason"]
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "decision": { "enum": ["refer", "do_not_refer", "insufficient_information"] },
        "decision_origin": { "enum": ["policy", "authorized_human_override"] },
        "decision_scope": { "const": "screening_route_only" },
        "issue_id": { "$ref": "medical_common.schema.json#/$defs/issue_id" },
        "rationale": { "type": "string", "minLength": 1 },
        "evidence_locator_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "medical_common.schema.json#/$defs/evidence_locator_id" } },
        "policy_version": { "type": ["string", "null"] },
        "additional_information_required": { "type": ["string", "null"], "minLength": 1 }
      },
      "required": ["decision", "decision_origin", "decision_scope", "issue_id", "rationale", "evidence_locator_ids", "policy_version", "additional_information_required"]
    },
    "request": { "$ref": "#/$defs/request_submission" }
  },
  "required": ["referral_inputs", "source_reinspection", "decision"],
  "allOf": [
    {
      "if": { "properties": { "decision": { "properties": { "decision": { "const": "refer" } }, "required": ["decision"] } }, "required": ["decision"] },
      "then": { "required": ["request"] },
      "else": { "not": { "required": ["request"] } }
    }
  ]
}