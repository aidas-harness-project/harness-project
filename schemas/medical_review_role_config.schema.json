{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "medical_review_role_config.schema.json",
  "title": "Medical-review role policy v0.1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "medical_review_role_config.v0.1" },
    "config_version": { "type": "string", "pattern": "^medical_review_roles\\.v[0-9]+\\.[0-9]+$" },
    "operations_enabled": { "type": "boolean" },
    "approval": { "oneOf": [{ "type": "null" }, { "$ref": "medical_review_common.schema.json#/$defs/approval" }] },
    "specialty_codes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "medical_review_common.schema.json#/$defs/specialty_code" } },
    "named_actors": { "type": "array", "items": { "$ref": "medical_review_common.schema.json#/$defs/actor_record" } },
    "action_permissions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "action": { "$ref": "medical_review_common.schema.json#/$defs/lifecycle_action" },
          "allowed_roles": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "medical_review_common.schema.json#/$defs/reviewer_role" } }
        },
        "required": ["action", "allowed_roles"]
      }
    }
  },
  "required": ["schema_version", "config_version", "operations_enabled", "approval", "specialty_codes", "named_actors", "action_permissions"],
  "allOf": [{
    "if": { "properties": { "operations_enabled": { "const": true } }, "required": ["operations_enabled"] },
    "then": { "properties": { "approval": { "$ref": "medical_review_common.schema.json#/$defs/approval" }, "named_actors": { "minItems": 1 }, "action_permissions": { "minItems": 1 } } }
  }]
}