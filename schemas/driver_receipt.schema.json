{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "driver_receipt.schema.json",
  "title": "Driver resume receipt v1",
  "type": "object",
  "properties": {
    "case_id": { "$ref": "common_component_output.schema.json#/$defs/case_id" },
    "run_id": { "type": "string", "pattern": "^RUN_[0-9]{8}_[0-9]+$" },
    "stage": { "type": "string", "pattern": "^[a-z0-9_]+$" },
    "unit_id": { "type": "string", "pattern": "^[A-Za-z0-9_]+$" },
    "input_fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "input_digests": {
      "type": "object",
      "additionalProperties": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
    },
    "prompt_version": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
    "response_schema_version": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
    "provider_name": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
    "model_name": { "type": "string", "pattern": "^[A-Za-z0-9._:/-]+$" },
    "completed_contracts": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" }
    },
    "status": { "enum": ["complete", "in_progress"] },
    "recorded_at": { "type": "string", "format": "date-time" }
  },
  "required": ["case_id", "run_id", "stage", "unit_id", "input_fingerprint", "input_digests", "prompt_version", "response_schema_version", "provider_name", "model_name", "completed_contracts", "status", "recorded_at"],
  "additionalProperties": false
}
