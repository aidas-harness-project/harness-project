{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "run_state.schema.json",
  "title": "_run_state.json -- pipeline run-state and backup tracker v0.3",
  "description": "The single source of truth for where a run stopped -- see harness-guardrails P7 and P10. Every stage's status is recorded here with timestamps; a crash or resume reads this file (via the DAO's get_last_passed_stage query) instead of re-deriving progress from scattered output files. After every stage passes, the orchestrator takes a full cumulative snapshot and records its path here -- one snapshot per passed stage, kept for the life of the run, never overwritten. v0.2: stage_name is an enum of the canonical stage names -- CASE_021's first full end-to-end run showed that free-form names silently fork one stage into several entries (document_processing vs document-pipeline, critic vs critic_v1) whenever a tool and an agent pick different spellings, which breaks get_last_passed_stage's resume logic and every consumer keying on stage_name.",
  "type": "object",
  "properties": {
    "run_state_version": { "const": "run_state.v0.3" },
    "case_id": { "$ref": "common_component_output.schema.json#/$defs/case_id" },
    "run_id": { "type": "string", "pattern": "^RUN_[0-9]{8}_[0-9]+$" },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "stages": {
      "type": "array",
      "items": { "$ref": "#/$defs/stage_entry" }
    },
    "human_input_status": {
      "type": "array",
      "description": "Tracks P7's human-input waits. Entries are never deleted, only updated in place (waiting -> received), so the full history of what was waited on stays visible.",
      "items": { "$ref": "#/$defs/human_input_entry" }
    },
    "medical_review_wait_reconciliation_operations": {
      "type": "array",
      "items": { "$ref": "#/$defs/medical_reconciliation_operation" }
    },
    "medical_review_adopted": { "type": "boolean" }
  },
  "required": ["run_state_version", "case_id", "run_id", "stages", "medical_review_adopted"],
  "$defs": {
    "stage_name": {
      "description": "Canonical stage names -- the ONLY values any producer (tool or agent) may write. Snake_case, versioned where the pipeline genuinely runs the stage once per draft version. If a new stage is added to the pipeline, it gets added here in the same change (D4).",
      "enum": [
        "intake",
        "document_processing",
        "indexing",
        "policy_clause_processing",
        "claim_analysis",
        "denial_response",
        "consistency_check",
        "screening_report",
        "draft_report_v1",
        "draft_report_v2",
        "critic_v1",
        "critic_v2",
        "denial_validation",
        "human_review_v1",
        "human_review_v2"
      ]
    },
    "stage_entry": {
      "type": "object",
      "properties": {
        "stage_name": { "$ref": "#/$defs/stage_name" },
        "status": { "enum": ["pending", "in_progress", "passed", "failed"] },
        "started_at": { "type": ["string", "null"], "format": "date-time" },
        "completed_at": { "type": ["string", "null"], "format": "date-time" },
        "attempt_count": {
          "type": "integer",
          "minimum": 0,
          "description": "Fixed retries under P9 -- max 3 for a partial/failed stage before it halts for user audit."
        },
        "backup_path": {
          "type": ["string", "null"],
          "description": "outputs/CASE_XXX/_backups/step_<N>_<stage_name>/ -- null until this stage has passed."
        }
      },
      "required": ["stage_name", "status", "attempt_count"]
    },
    "human_input_entry": {
      "type": "object",
      "properties": {
        "stage_name": { "$ref": "#/$defs/stage_name" },
        "status": { "enum": ["waiting", "received", "no_longer_required"] },
        "description": {
          "type": "string",
          "description": "What input is/was pending -- e.g. 'expert review of draft_report_v1'."
        },
        "requested_at": { "type": "string", "format": "date-time" },
        "received_at": { "type": ["string", "null"], "format": "date-time" },
        "input_kind": { "enum": ["referral_decision", "medical_evidence", "expert_assignment", "expert_response", "coordinator_disposition", "medical_adjudication"] },
        "human_input_id": { "$ref": "medical_review_common.schema.json#/$defs/human_input_id" },
        "review_item_id": { "oneOf": [{ "type": "null" }, { "$ref": "medical_review_common.schema.json#/$defs/review_item_id" }] },
        "related_review_item_ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "medical_review_common.schema.json#/$defs/review_item_id" } },
        "request_id": { "oneOf": [{ "type": "null" }, { "$ref": "medical_review_common.schema.json#/$defs/request_id" }] },
        "adjudication_id": { "oneOf": [{ "type": "null" }, { "$ref": "medical_review_common.schema.json#/$defs/adjudication_id" }] },
        "wait_cycle": { "type": "integer", "minimum": 1 },
        "resolved_at": { "type": ["string", "null"], "format": "date-time" },
        "resolution": { "type": ["string", "null"], "minLength": 1 }
      },
      "required": ["stage_name", "status", "description", "requested_at"],
      "allOf": [{
        "if": { "required": ["human_input_id"] },
        "then": {
          "required": ["input_kind", "human_input_id", "review_item_id", "related_review_item_ids", "request_id", "adjudication_id", "wait_cycle", "resolved_at", "resolution"],
          "oneOf": [
            {
              "properties": {
                "input_kind": { "not": { "const": "medical_adjudication" } },
                "review_item_id": { "$ref": "medical_review_common.schema.json#/$defs/review_item_id" },
                "related_review_item_ids": { "maxItems": 0 },
                "adjudication_id": { "type": "null" }
              }
            },
            {
              "properties": {
                "input_kind": { "const": "medical_adjudication" },
                "review_item_id": { "type": "null" },
                "related_review_item_ids": { "minItems": 2 },
                "request_id": { "type": "null" },
                "adjudication_id": { "$ref": "medical_review_common.schema.json#/$defs/adjudication_id" }
              }
            }
          ]
        }
      }]
    },
    "medical_reconciliation_operation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "operation_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$" },
        "request_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "medical_review_ledger_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "receipt_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "completed_at": { "type": "string", "format": "date-time" }
      },
      "required": ["operation_id", "request_sha256", "medical_review_ledger_sha256", "receipt_sha256", "completed_at"]
    }
  }
}
