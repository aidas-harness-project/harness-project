{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "medical_review_outcomes.schema.json",
  "title": "Current downstream medical-review outcomes v0.1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "medical_review_outcomes.v0.1" },
    "case_id": { "$ref": "common_component_output.schema.json#/$defs/case_id" },
    "medical_variables_revision": { "$ref": "medical_review_common.schema.json#/$defs/medical_variables_revision" },
    "ledger_updated_at": { "type": "string", "format": "date-time" },
    "review_items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "review_item_id": { "$ref": "medical_review_common.schema.json#/$defs/review_item_id" },
          "issue_id": { "$ref": "medical_common.schema.json#/$defs/issue_id" },
          "state": { "enum": ["do_not_refer", "cancelled", "closed"] },
          "target_medical_variables_revision": { "$ref": "medical_review_common.schema.json#/$defs/medical_variables_revision" },
          "decision": {
            "oneOf": [
              { "type": "null" },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "decision_id": { "$ref": "medical_review_common.schema.json#/$defs/decision_id" },
                  "decision": { "enum": ["refer", "do_not_refer", "insufficient_information"] },
                  "decision_origin": { "enum": ["policy", "authorized_human_override"] },
                  "rationale": { "type": "string", "minLength": 1 },
                  "medical_variables_revision": { "$ref": "medical_common.schema.json#/$defs/medical_variable_revision" }
                },
                "required": ["decision_id", "decision", "decision_origin", "rationale", "medical_variables_revision"]
              }
            ]
          },
          "response": {
            "oneOf": [
              { "type": "null" },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "response_id": { "$ref": "medical_review_common.schema.json#/$defs/response_id" },
                  "response_version": { "type": "integer", "minimum": 1 },
                  "request_id": { "$ref": "medical_review_common.schema.json#/$defs/request_id" },
                  "request_version_reviewed": { "type": "integer", "minimum": 1 },
                  "issue_id": { "$ref": "medical_common.schema.json#/$defs/issue_id" },
                  "issue_category": { "$ref": "medical_common.schema.json#/$defs/issue_category" },
                  "decision_id": { "$ref": "medical_review_common.schema.json#/$defs/decision_id" },
                  "evidence_locator_ids_reviewed": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "medical_common.schema.json#/$defs/evidence_locator_id" } },
                  "interpretation": { "type": "string", "minLength": 1 },
                  "basis": { "type": "string", "minLength": 1 },
                  "uncertainty": { "type": "string", "minLength": 1 },
                  "alternative_interpretations": { "type": "array", "items": { "type": "string", "minLength": 1 } },
                  "downstream_adjustment_advice": { "type": ["string", "null"], "minLength": 1 },
                  "supersedes_response_id": { "oneOf": [{ "type": "null" }, { "$ref": "medical_review_common.schema.json#/$defs/response_id" }] },
                  "response_status": { "enum": ["completed", "amended", "withdrawn"] },
                  "reviewer": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "display_name": { "type": "string", "minLength": 1 },
                      "declared_role": { "$ref": "medical_review_common.schema.json#/$defs/reviewer_role" },
                      "specialty_code": { "$ref": "medical_review_common.schema.json#/$defs/specialty_code" }
                    },
                    "required": ["display_name", "declared_role", "specialty_code"]
                  },
                  "reviewed_at": { "type": "string", "format": "date-time" },
                  "submitted_at": { "type": "string", "format": "date-time" }
                },
                "required": ["response_id", "response_version", "request_id", "request_version_reviewed", "issue_id", "issue_category", "decision_id", "evidence_locator_ids_reviewed", "interpretation", "basis", "uncertainty", "alternative_interpretations", "downstream_adjustment_advice", "supersedes_response_id", "response_status", "reviewer", "reviewed_at", "submitted_at"]
              }
            ]
          },
          "adjudication": {
            "oneOf": [
              { "type": "null" },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "adjudication_id": { "$ref": "medical_review_common.schema.json#/$defs/adjudication_id" },
                  "record": { "type": "string", "minLength": 1 },
                  "resolved_at": { "type": "string", "format": "date-time" }
                },
                "required": ["adjudication_id", "record", "resolved_at"]
              }
            ]
          }
        },
        "required": ["review_item_id", "issue_id", "state", "target_medical_variables_revision", "decision", "response", "adjudication"]
      }
    }
  },
  "required": ["schema_version", "case_id", "medical_variables_revision", "ledger_updated_at", "review_items"]
}
