{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "source_ledger.schema.json",
  "title": "_source_ledger.json -- per-file intake review ledger v0.4",
  "description": "Per-file classification (raw vs. ground_truth) and human review status for a case's intake. See harness-guardrails-dev D2. Every file starts pending; intake will not copy any file while any entry is pending, and a single rejected entry blocks the whole case's intake. This is a shared state file, not a component output -- it does not use the common output envelope. Written/read only through the DAO (read_ledger / set_ledger_status).",
  "type": "object",
  "properties": {
    "ledger_version": { "const": "source_ledger.v0.4" },
    "case_id": { "$ref": "common_component_output.schema.json#/$defs/case_id" },
    "source_dir": {
      "type": "string",
      "description": "The source-cases/ folder this case was intake'd from."
    },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/ledger_entry" }
    },
    "history_boundary": { "$ref": "#/$defs/history_boundary" },
    "operations": {
      "type": "array",
      "items": { "$ref": "#/$defs/operation" }
    }
  },
  "required": ["ledger_version", "case_id", "source_dir", "files", "history_boundary", "operations"],
  "$defs": {
    "history_boundary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": { "enum": ["native", "legacy_snapshot"] },
        "established_at": { "type": "string", "format": "date-time" },
        "baseline_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "absorbed_operation_count": { "type": "integer", "minimum": 0 },
        "absorbed_operations_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "forked_operation_count": { "type": "integer", "minimum": 0 },
        "forked_operations_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "predecessor_state_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "baseline_state": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/ledger_entry" }
        }
      },
      "required": ["mode", "established_at", "baseline_sha256", "baseline_state"],
      "dependentRequired": {
        "absorbed_operation_count": ["absorbed_operations_sha256"],
        "absorbed_operations_sha256": ["absorbed_operation_count"],
        "forked_operation_count": ["forked_operations_sha256"],
        "forked_operations_sha256": ["forked_operation_count"]
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "operation_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$" },
        "request": { "$ref": "#/$defs/operation_request" },
        "request_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "result": { "$ref": "#/$defs/operation_result" },
        "completed_at": { "type": "string", "format": "date-time" }
      },
      "required": ["operation_id", "request", "request_sha256", "result", "completed_at"]
    },
    "operation_request": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "case_id": { "$ref": "common_component_output.schema.json#/$defs/case_id" },
        "operation_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$" },
        "action": { "const": "set_status" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "file_name": { "type": "string", "minLength": 1 },
            "status": { "enum": ["pending", "approved", "rejected"] },
            "reviewer": { "type": ["string", "null"] },
            "reason": { "type": ["string", "null"] }
          },
          "required": ["file_name", "status", "reviewer", "reason"]
        }
      },
      "required": ["case_id", "operation_id", "action", "payload"]
    },
    "operation_result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "action": { "const": "set_status" },
        "target_id": { "type": "string", "minLength": 1 },
        "status": { "enum": ["pending", "approved", "rejected"] }
      },
      "required": ["action", "target_id", "status"]
    },
    "ledger_entry": {
      "type": "object",
      "properties": {
        "file_name": { "type": "string" },
        "classification": {
          "enum": ["raw", "ground_truth"],
          "description": "Proposed by filename-pattern matching at intake."
        },
        "review_status": {
          "enum": ["pending", "approved", "rejected"],
          "description": "Starts pending for every file. Only a human sets approved/rejected -- see D2."
        },
        "reviewed_by": {
          "type": ["string", "null"],
          "description": "null while pending."
        },
        "reviewed_at": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "rejection_reason": {
          "type": ["string", "null"],
          "description": "Required when review_status is rejected -- why the proposed classification looks wrong."
        },
        "content_warning": {
          "type": "object",
          "description": "Set by intake's content pre-check (tools/intake_case.py) when a file proposed as 'raw' shows signs of answer-key-class content (a completed loss-adjustment report, a stated payout determination) despite a filename that didn't flag it -- see harness-guardrails-dev D2 and known-gaps.md item 2's CASE_002 incident, which this exists to catch. Does not block approval by itself -- surfaces the risk so the human review this file still requires doesn't miss it. Absent (not present at all, not null) when the file wasn't flagged or wasn't eligible for the scan (non-PDF, or a --split-derived file, which isn't scanned -- see the tool's docstring).",
          "properties": {
            "evidence": {
              "type": "string",
              "description": "The vision model's stated reasoning/quoted text for flagging this file. An unparseable model response is recorded here too, flagged for safety rather than silently passed."
            },
            "pages_checked": {
              "type": "integer",
              "minimum": 1,
              "description": "How many pages from the start of the document were examined (a signal check, not a full read -- document-pipeline's checkpoint 1 still owns the real OCR/P8 cross-validation)."
            },
            "checked_at": {
              "type": "string",
              "format": "date-time"
            }
          },
          "required": ["evidence", "pages_checked", "checked_at"]
        }
      },
      "required": ["file_name", "classification", "review_status"]
    }
  }
}
