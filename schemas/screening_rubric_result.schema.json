{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "screening_rubric_result.schema.json",
  "title": "screening_rubric_result.json -- reference-free screening-report score v0.1",
  "description": "Produced by screening-rubric: a score for how well a screening report was written, measured against templates/rubric-screening-report.md. Reference-free -- it compares a report to a rubric, never to ground truth. Ground-truth comparison remains evaluation_result.schema.json's, which belongs to the deferred isolated Unit 11 service; the two must not be confused because they answer different questions and only one of them is available locally. Two structural rules make a score checkable rather than assertable: an applicable axis must quote the report it scored (evidence_quotes minItems 1), and the result must name the exact bytes it scored (target_report_sha256). All six axes and all five gates are always present -- an inapplicable axis is recorded applicable:false with a reason, since omitting it would drop it from the weighted denominator with nothing left on the record to say so.",
  "allOf": [
    {
      "$ref": "common_component_output.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "screening_rubric_result.v0.1"
        },
        "rubric_version": {
          "const": "screening_rubric.v0.1",
          "description": "Which revision of templates/rubric-screening-report.md produced this score. Scores from different rubric revisions are not comparable; without this field a cross-run comparison silently mixes them."
        },
        "target_report_path": {
          "type": "string",
          "minLength": 1,
          "description": "Path to the screening report markdown that was scored."
        },
        "target_report_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "SHA-256 of the scored report's bytes. Binds the score to one exact document version -- the same device screening_report.schema.json uses with source_denial_contract_hash. Rewrite the report and this score no longer matches it, visibly."
        },
        "axis_scores": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/axis_score"
          },
          "description": "One entry per rubric axis, A1-A6, in any order but each exactly once."
        },
        "weighted_total": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "100 * sum_applicable(raw/4 * weight) / sum_applicable(weight), one decimal. Axes recorded applicable:false leave the denominator, so a report is not penalised for an axis its case never engaged."
        },
        "gates": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "$ref": "#/$defs/gate"
          },
          "description": "One entry per gate, G1-G5, each exactly once. A gate is categorical: any triggered gate sets verdict to blocked whatever weighted_total says."
        },
        "verdict": {
          "enum": [
            "pass",
            "revise",
            "blocked"
          ],
          "description": "blocked when any gate triggered; otherwise pass when weighted_total >= 80, else revise."
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/finding"
          },
          "description": "What to change, numbered stably so a human disposition can reference one. An empty array is a valid outcome and means no change was called for -- not that findings were skipped."
        }
      },
      "required": [
        "case_id",
        "run_id",
        "component",
        "status",
        "schema_version",
        "rubric_version",
        "target_report_path",
        "target_report_sha256",
        "axis_scores",
        "weighted_total",
        "gates",
        "verdict",
        "findings"
      ]
    },
    {
      "$comment": "axis_id and gate_id each appear exactly once. uniqueItems cannot express this on objects that differ in other fields, so the constraint is stated per id.",
      "allOf": [
        {
          "properties": {
            "axis_scores": {
              "allOf": [
                {
                  "contains": {
                    "properties": {
                      "axis_id": {
                        "const": "A1"
                      }
                    },
                    "required": [
                      "axis_id"
                    ]
                  },
                  "minContains": 1,
                  "maxContains": 1
                },
                {
                  "contains": {
                    "properties": {
                      "axis_id": {
                        "const": "A2"
                      }
                    },
                    "required": [
                      "axis_id"
                    ]
                  },
                  "minContains": 1,
                  "maxContains": 1
                },
                {
                  "contains": {
                    "properties": {
                      "axis_id": {
                        "const": "A3"
                      }
                    },
                    "required": [
                      "axis_id"
                    ]
                  },
                  "minContains": 1,
                  "maxContains": 1
                },
                {
                  "contains": {
                    "properties": {
                      "axis_id": {
                        "const": "A4"
                      }
                    },
                    "required": [
                      "axis_id"
                    ]
                  },
                  "minContains": 1,
                  "maxContains": 1
                },
                {
                  "contains": {
                    "properties": {
                      "axis_id": {
                        "const": "A5"
                      }
                    },
                    "required": [
                      "axis_id"
                    ]
                  },
                  "minContains": 1,
                  "maxContains": 1
                },
                {
                  "contains": {
                    "properties": {
                      "axis_id": {
                        "const": "A6"
                      }
                    },
                    "required": [
                      "axis_id"
                    ]
                  },
                  "minContains": 1,
                  "maxContains": 1
                }
              ]
            },
            "gates": {
              "allOf": [
                {
                  "contains": {
                    "properties": {
                      "gate_id": {
                        "const": "G1"
                      }
                    },
                    "required": [
                      "gate_id"
                    ]
                  },
                  "minContains": 1,
                  "maxContains": 1
                },
                {
                  "contains": {
                    "properties": {
                      "gate_id": {
                        "const": "G2"
                      }
                    },
                    "required": [
                      "gate_id"
                    ]
                  },
                  "minContains": 1,
                  "maxContains": 1
                },
                {
                  "contains": {
                    "properties": {
                      "gate_id": {
                        "const": "G3"
                      }
                    },
                    "required": [
                      "gate_id"
                    ]
                  },
                  "minContains": 1,
                  "maxContains": 1
                },
                {
                  "contains": {
                    "properties": {
                      "gate_id": {
                        "const": "G4"
                      }
                    },
                    "required": [
                      "gate_id"
                    ]
                  },
                  "minContains": 1,
                  "maxContains": 1
                },
                {
                  "contains": {
                    "properties": {
                      "gate_id": {
                        "const": "G5"
                      }
                    },
                    "required": [
                      "gate_id"
                    ]
                  },
                  "minContains": 1,
                  "maxContains": 1
                }
              ]
            }
          }
        }
      ]
    }
  ],
  "$defs": {
    "axis_score": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "axis_id": {
          "enum": [
            "A1",
            "A2",
            "A3",
            "A4",
            "A5",
            "A6"
          ],
          "description": "A1 structural completeness / A2 core-variable coverage / A3 evidence-tier grounding / A4 case-type and required-document coherence / A5 issue and assessment actionability / A6 internal consistency."
        },
        "raw": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 4,
          "description": "Anchor level from the rubric. Null only when applicable is false."
        },
        "weight": {
          "type": "number",
          "minimum": 0,
          "description": "Rubric weight: A1 10, A2 25, A3 15, A4 20, A5 15, A6 15."
        },
        "applicable": {
          "type": "boolean"
        },
        "na_reason": {
          "type": [
            "string",
            "null"
          ],
          "description": "Why this axis cannot apply to this report. Required when applicable is false -- an unexplained N/A is indistinguishable from a dodged low score."
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "evidence_quotes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Verbatim lines from the scored report. At least one when the axis applies: a level without a quote cannot be checked by the person reading the score."
        }
      },
      "required": [
        "axis_id",
        "raw",
        "weight",
        "applicable",
        "na_reason",
        "rationale",
        "evidence_quotes"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "applicable": {
                "const": true
              }
            },
            "required": [
              "applicable"
            ]
          },
          "then": {
            "properties": {
              "raw": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4
              },
              "evidence_quotes": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "applicable": {
                "const": false
              }
            },
            "required": [
              "applicable"
            ]
          },
          "then": {
            "properties": {
              "na_reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gate_id": {
          "enum": [
            "G1",
            "G2",
            "G3",
            "G4",
            "G5"
          ],
          "description": "G1 forbidden expression / G2 advisory-judgment encroachment / G3 unscoped absence claim / G4 cross-section factual contradiction / G5 case-type and coverage contradiction."
        },
        "triggered": {
          "type": "boolean"
        },
        "quote": {
          "type": [
            "string",
            "null"
          ],
          "description": "The report line that triggered the gate. Required when triggered -- a categorical failure asserted without the offending text cannot be disputed or fixed."
        },
        "section": {
          "type": [
            "string",
            "null"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "gate_id",
        "triggered",
        "quote",
        "section",
        "description"
      ],
      "if": {
        "properties": {
          "triggered": {
            "const": true
          }
        },
        "required": [
          "triggered"
        ]
      },
      "then": {
        "properties": {
          "quote": {
            "type": "string",
            "minLength": 1
          },
          "section": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "finding_id": {
          "type": "string",
          "pattern": "^SR-[0-9]+$"
        },
        "severity": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "section": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "fix_suggestion": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "finding_id",
        "severity",
        "section",
        "description",
        "fix_suggestion"
      ]
    }
  }
}
