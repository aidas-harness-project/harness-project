{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "medical_common.schema.json",
  "title": "Shared medical evidence definitions v0.1",
  "description": "Definitions shared by medical-variable and medical-review contracts. This file intentionally does not own actors, reviewer roles, specialties, or lifecycle states.",
  "$defs": {
    "schema_version": { "type": "string", "pattern": "^[a-z][a-z0-9_]*\\.v[0-9]+\\.[0-9]+$" },
    "config_version": { "type": "string", "pattern": "^[a-z][a-z0-9_]*\\.v[0-9]+\\.[0-9]+$" },
    "medical_variable_revision": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "run_id": { "type": "string", "pattern": "^RUN_[0-9]{8}_[0-9]+$" },
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "config_version": { "$ref": "#/$defs/config_version" }
      },
      "required": ["sha256", "run_id", "schema_version", "config_version"]
    },
    "issue_id": { "type": "string", "pattern": "^MCI_[0-9]{4,}$" },
    "issue_evidence_link_id": { "type": "string", "pattern": "^MIEL_[0-9]{4,}$" },
    "variable_id": { "type": "string", "pattern": "^MV_[0-9]{4,}$" },
    "observation_id": { "type": "string", "pattern": "^MO_[0-9]{4,}$" },
    "evidence_locator_id": { "type": "string", "pattern": "^MEV_[0-9]{4,}$" },
    "importance_id": { "type": "string", "pattern": "^MIA_[0-9]{4,}$" },
    "importance_assignment_id": { "type": "string", "pattern": "^MIA_[0-9]{4,}$" },
    "contradiction_group_id": { "type": "string", "pattern": "^MCG_[0-9]{4,}$" },
    "quantity_id": { "type": "string", "pattern": "^MQ_[0-9]{4,}$" },
    "issue_category": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "source_coverage_status": {
      "enum": ["consumed", "human_only_not_consumed", "unsupported_needs_configuration", "blocked_upstream", "out_of_scope"]
    },
    "table_location": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "table": { "type": "string", "minLength": 1 },
        "row": { "type": "string", "minLength": 1 },
        "column": { "type": "string", "minLength": 1 },
        "value": { "type": "string", "minLength": 1 }
      },
      "required": ["table", "row", "column", "value"]
    },
    "page_region": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "x": { "type": "number", "minimum": 0 },
        "y": { "type": "number", "minimum": 0 },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 },
        "coordinate_space": { "const": "page_points" }
      },
      "required": ["x", "y", "width", "height", "coordinate_space"]
    },
    "evidence_locator": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "locator_id": { "$ref": "#/$defs/evidence_locator_id" },
        "document_id": { "$ref": "common_component_output.schema.json#/$defs/document_id" },
        "page": { "type": "integer", "minimum": 1 },
        "quote": { "type": "string", "minLength": 1 },
        "table_location": { "$ref": "#/$defs/table_location" },
        "document_name": { "type": "string", "minLength": 1 },
        "document_date": { "type": "string", "format": "date" },
        "chunk_id": { "type": "string", "minLength": 1 },
        "section": { "type": "string", "minLength": 1 },
        "page_region": { "$ref": "#/$defs/page_region" }
      },
      "required": ["locator_id", "document_id", "page"],
      "oneOf": [
        { "required": ["quote"], "not": { "required": ["table_location"] } },
        { "required": ["table_location"], "not": { "required": ["quote"] } }
      ]
    },
    "temporal_endpoint": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": { "precision": { "const": "day" }, "value": { "type": "string", "format": "date" } },
          "required": ["precision", "value"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": { "precision": { "const": "month" }, "value": { "type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$" } },
          "required": ["precision", "value"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": { "precision": { "const": "year" }, "value": { "type": "string", "pattern": "^[0-9]{4}$" } },
          "required": ["precision", "value"]
        }
      ]
    },
    "temporal_point": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "point" },
        "precision": { "enum": ["day", "month", "year"] },
        "value": { "type": "string" },
        "raw_text": { "type": "string", "minLength": 1 }
      },
      "required": ["kind", "precision", "value", "raw_text"],
      "allOf": [
        {
          "if": { "properties": { "precision": { "const": "day" } }, "required": ["precision"] },
          "then": { "properties": { "value": { "format": "date" } } }
        },
        {
          "if": { "properties": { "precision": { "const": "month" } }, "required": ["precision"] },
          "then": { "properties": { "value": { "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$" } } }
        },
        {
          "if": { "properties": { "precision": { "const": "year" } }, "required": ["precision"] },
          "then": { "properties": { "value": { "pattern": "^[0-9]{4}$" } } }
        }
      ]
    },
    "temporal_range": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "range" },
        "start": { "$ref": "#/$defs/temporal_endpoint" },
        "end": { "$ref": "#/$defs/temporal_endpoint" },
        "raw_text": { "type": "string", "minLength": 1 }
      },
      "required": ["kind", "start", "end", "raw_text"]
    },
    "temporal_unknown": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "unknown" },
        "reason": { "type": "string", "minLength": 1 }
      },
      "required": ["kind", "reason"]
    },
    "temporal_value": {
      "oneOf": [
        { "$ref": "#/$defs/temporal_point" },
        { "$ref": "#/$defs/temporal_range" }
      ]
    },
    "observed_at": {
      "oneOf": [
        { "$ref": "#/$defs/temporal_point" },
        { "$ref": "#/$defs/temporal_range" },
        { "$ref": "#/$defs/temporal_unknown" }
      ]
    }
  }
}