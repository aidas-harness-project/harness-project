  "case_type_rules": [
    {
      "case_type": "personal_insurance",
      "positive_fact": "A documented external injury event can be handled as a personal-insurance review target even when contract or filing information is unknown.",
      "uncertain_fact": null,
      "evaluation_mode": "independent_parallel",
      "absence_means_false": false,
      "evidence_required": true
    },
    {
      "case_type": "traffic_accident",
      "positive_fact": "The injury event explicitly involves a vehicle or traffic accident.",
      "uncertain_fact": null,
      "evaluation_mode": "independent_parallel",
      "absence_means_false": false,
      "evidence_required": true
    },
    {
      "case_type": "industrial_accident",
      "positive_fact": "The injury occurred during explicitly documented work activity.",
      "uncertain_fact": "Commute, business trip, and company-event contexts remain uncertain unless work connection is explicit.",
      "evaluation_mode": "independent_parallel",
      "absence_means_false": false,
      "evidence_required": true
    },
    {
      "case_type": "liability",
      "positive_fact": "The injury narrative explicitly identifies a facility defect or a responsible act or omission by another party.",
      "uncertain_fact": "A mere location or presence of another person does not establish responsibility.",
      "evaluation_mode": "independent_parallel",
      "absence_means_false": false,
      "evidence_required": true
    }
  ],
